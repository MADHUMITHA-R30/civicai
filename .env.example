# ==============================================================================
# CivicAI - Cloud Deployment & Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values before deploying to cloud or Docker.

# --- SERVER & PORT CONFIGURATION ---
PORT=8080
AI_SERVICE_PORT=8000

# --- SPRING BOOT DATABASE CONFIGURATION ---
# Default profile: dev (uses H2 in-memory). Set to "mysql" or "prod" for cloud databases.
SPRING_PROFILES_ACTIVE=mysql

# Cloud MySQL / MariaDB / Aurora connection settings:
# Example Render/Railway: jdbc:mysql://mysql.railway.internal:3306/railway?useSSL=true
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/civicai_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=civic_user
SPRING_DATASOURCE_PASSWORD=your_strong_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# --- SECURITY & JWT CREDENTIALS ---
# Secret must be at least 256 bits (32+ characters)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_256bit
JWT_EXPIRATION_MS=86400000

# --- FASTAPI AI MICROSERVICE CONNECTION ---
# Internal or public URL pointing to the FastAPI service
AI_SERVICE_URL=http://localhost:8000

# --- FILE STORAGE & UPLOADS ---
# Path where image uploads are saved on disk or mounted cloud persistent volume
UPLOAD_DIR=uploads

# --- CORS ALLOWED ORIGINS ---
# Comma-separated list of allowed web origins, or * for all
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,https://your-civicai-domain.com

# --- DOCKER COMPOSE DEFAULTS (Optional) ---
DB_NAME=civicai_db
DB_USERNAME=civic_user
DB_PASSWORD=civic_pass
DB_ROOT_PASSWORD=root_secret
